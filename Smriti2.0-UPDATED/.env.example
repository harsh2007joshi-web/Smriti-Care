# ============================================================
# SMRITICARE NER - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Supabase Public Configuration (Frontend Safe)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key

# AI Integration (Optional Gemini API for Edge Functions)
# Used only inside Supabase Edge Functions. NEVER expose in frontend.
GEMINI_API_KEY=your-google-gemini-api-key

# SMS Provider Configuration (For Real Live SMS OTP to Phones)
# 1. 2Factor.in (India Real SMS OTP Gateway - https://2factor.in)
VITE_TWOFACTOR_API_KEY=your_2factor_api_key_here

# 2. Fast2SMS (Alternative Indian SMS Gateway - https://www.fast2sms.com)
VITE_FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Options: '2factor' | 'fast2sms' | 'supabase_native' | 'twilio' | 'dev_mock'
SMS_PROVIDER=dev_mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

